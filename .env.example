# Scout Microservices Environment Configuration
APP_ENV=development

# API Gateway Service
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0
GATEWAY_AUTH_SERVICE_URL=http://auth-service:8001
GATEWAY_OPPORTUNITY_SERVICE_URL=http://opportunity-service:8002
GATEWAY_INGESTION_SERVICE_URL=http://ingestion-service:8003
GATEWAY_NOTIFICATION_SERVICE_URL=http://notification-service:8004

# Auth Service — PostgreSQL (external)
AUTH_PORT=8001
AUTH_HOST=0.0.0.0
AUTH_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/auth_service

# Opportunity Service — MongoDB (external)
OPPORTUNITY_PORT=8002
OPPORTUNITY_HOST=0.0.0.0
OPPORTUNITY_DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/opportunity_service
ELASTICSEARCH_URL=http://elasticsearch:9200

# Ingestion Service — MongoDB (external)
INGESTION_PORT=8003
INGESTION_HOST=0.0.0.0
INGESTION_DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/ingestion_service
GITHUB_TOKEN=

# Notification Service — MongoDB (external)
NOTIFICATION_PORT=8004
NOTIFICATION_HOST=0.0.0.0
NOTIFICATION_DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/notification_service

# Shared Infrastructure
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Logging
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

SERPER_API_KEY=your_serper_api_key
